# URL de tu instancia de n8n (la que ya tenés abierta en el navegador).
# Ej: http://localhost:5678  o  https://tu-subdominio.app.n8n.cloud
N8N_API_URL=http://localhost:5678

# n8n > Settings > n8n API > Create an API key
N8N_API_KEY=

# Credenciales de Meta Graph API (Facebook Page + Instagram Business)
# Se generan en https://developers.facebook.com (una app de tipo "Business")
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_BUSINESS_ACCOUNT_ID=
META_IG_ACCESS_TOKEN=

# TikTok Content Posting API (app en https://developers.tiktok.com,
# scope video.publish). El access_token es de corta duración (~24hs):
# hay que refrescarlo con el refresh_token periódicamente.
TIKTOK_ACCESS_TOKEN=

# YouTube Data API v3: NO va acá. Se configura como credencial OAuth2
# dentro de n8n (Credentials > New > YouTube OAuth2 API), con nombre
# "YouTube account", usando un cliente OAuth de Google Cloud Console
# con la YouTube Data API v3 habilitada.
