# URL de tu instancia de n8n (la que ya tenés abierta en el navegador).
# Ej: http://localhost:5678  o  https://tu-subdominio.app.n8n.cloud
N8N_API_URL=http://localhost:5678

# n8n > Settings > n8n API > Create an API key
N8N_API_KEY=

# Credenciales de Meta Graph API (Facebook Page + Instagram Business)
# Se generan en https://developers.facebook.com (una app de tipo "Business")
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_BUSINESS_ACCOUNT_ID=
META_IG_ACCESS_TOKEN=

# TikTok Content Posting API (app en https://developers.tiktok.com,
# scope video.publish). El access_token es de corta duración (~24hs):
# hay que refrescarlo con el refresh_token periódicamente.
TIKTOK_ACCESS_TOKEN=

# YouTube Data API v3: NO va acá. Se configura como credencial OAuth2
# dentro de n8n (Credentials > New > YouTube OAuth2 API), con nombre
# "YouTube account", usando un cliente OAuth de Google Cloud Console
# con la YouTube Data API v3 habilitada.

# ---------------------------------------------------------------
# Asistente de turnos por WhatsApp (ver WHATSAPP-TURNOS.md)
# ---------------------------------------------------------------
# URL pública de tu n8n (la que ve internet, con https). Mercado Pago
# avisa los pagos a  $N8N_PUBLIC_URL/webhook/mercadopago-biobalance
N8N_PUBLIC_URL=https://tu-n8n.ejemplo.com

# Meta for Developers > tu app > WhatsApp > Configuración de la API
# ("Identificador del número de teléfono" / Phone number ID)
WHATSAPP_PHONE_NUMBER_ID=

# Google Calendar donde quedan los turnos. Calendar > Configuración del
# calendario > "Integrar el calendario" > ID del calendario
GOOGLE_CALENDAR_ID=

# Mercado Pago > Tus integraciones > tu aplicación > Credenciales de
# producción > Access Token (empieza con APP_USR-). Para probar, usá las
# credenciales de prueba (TEST-...).
MP_ACCESS_TOKEN=

# Avisos a la terapeuta (reservas, señas pagadas, horarios liberados y
# personas que piden hablar con ella). Número en formato internacional sin
# "+", tal como lo muestra WhatsApp: ej. 5492954XXXXXX
# Tiene que ser OTRO número distinto del del asistente. Si usás un solo
# número para todo, dejalo vacío: los avisos llegan solo por mail.
AVISOS_WHATSAPP=
# Mail de respaldo: los avisos llegan siempre también por acá (credencial
# "Gmail account" en n8n).
AVISOS_EMAIL=biobalance.consultas@gmail.com
