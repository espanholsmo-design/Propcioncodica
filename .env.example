# URL de tu instancia de n8n (la que ya tenés abierta en el navegador).
# Ej: http://localhost:5678  o  https://tu-subdominio.app.n8n.cloud
N8N_API_URL=http://localhost:5678

# n8n > Settings > n8n API > Create an API key
N8N_API_KEY=

# Credenciales de Meta Graph API (Facebook Page + Instagram Business)
# Se generan en https://developers.facebook.com (una app de tipo "Business")
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_BUSINESS_ACCOUNT_ID=
META_IG_ACCESS_TOKEN=
