{
  "name": "BioBalance - Liberar turnos con seña vencida",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "cron",
      "name": "Cada 15 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.GOOGLE_CALENDAR_ID }}"
        },
        "returnAll": true,
        "timeMin": "={{ $now }}",
        "timeMax": "={{ $now.plus({ days: 60 }) }}",
        "options": {
          "singleEvents": true,
          "query": "PENDIENTE SEÑA"
        }
      },
      "id": "pendientes",
      "name": "Turnos próximos",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        220,
        300
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "p",
              "leftValue": "={{ $json.summary }}",
              "rightValue": "PENDIENTE SEÑA",
              "operator": {
                "type": "string",
                "operation": "startsWith"
              }
            },
            {
              "id": "v",
              "leftValue": "={{ DateTime.fromISO($json.created).plus({ minutes: 70 }) < $now }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "vencidos",
      "name": "¿Seña vencida?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "operation": "delete",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.GOOGLE_CALENDAR_ID }}"
        },
        "eventId": "={{ $json.id }}",
        "options": {
          "sendUpdates": "none"
        }
      },
      "id": "borrar",
      "name": "Liberar horario",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        660,
        300
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "",
          "name": "Google Calendar account"
        }
      }
    },
    {
      "parameters": {
        "operation": "send",
        "phoneNumberId": "={{ $env.WHATSAPP_PHONE_NUMBER_ID }}",
        "recipientPhoneNumber": "={{ $('¿Seña vencida?').item.json.description.match(/Tel: (\\d+)/)?.[1] }}",
        "textBody": "Hola 🌿 Como no se registró la seña, liberamos el horario que te habíamos guardado. Si todavía querés tu turno, escribinos por acá y te buscamos uno nuevo 🦋",
        "additionalFields": {}
      },
      "id": "wa-vencido",
      "name": "Avisar que se liberó",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1.1,
      "position": [
        880,
        300
      ],
      "credentials": {
        "whatsAppApi": {
          "id": "",
          "name": "WhatsApp account"
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Cada 15 minutos": {
      "main": [
        [
          {
            "node": "Turnos próximos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Turnos próximos": {
      "main": [
        [
          {
            "node": "¿Seña vencida?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Seña vencida?": {
      "main": [
        [
          {
            "node": "Liberar horario",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Liberar horario": {
      "main": [
        [
          {
            "node": "Avisar que se liberó",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Argentina/Buenos_Aires"
  }
}
